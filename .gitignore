__pycache__/
*.py[cod]
.pytest_cache/
.tmp/
.venv/
/.venv-lmta-v42/
build/
dist/
*.egg-info/

# Reproducible generated runs.  Keep only an empty anchor in version control.
artifacts/*
!artifacts/.gitkeep

# Publish research summaries and recent complete evidence; retain bulky older
# trajectories, sampled records and training outputs locally.
/reports/**
!/reports/**/
!/reports/**/*.md
!/reports/**/*.log
!/reports/**/*analysis*.json
!/reports/**/*summary*.json
!/reports/**/*checks*.json
!/reports/**/*diagnostic*.json
!/reports/**/*roster*.json
!/reports/**/manifest.json
!/reports/**/verification.json
!/reports/**/*.run_attempt.json
!/reports/*_plan_*.json
!/reports/*_v69.*
!/reports/*_v7[0-6].*
!/reports/controlled_predictive_composition_v69/**
!/reports/controlled_predictive_observation_v70/**
!/reports/controlled_predictive_symbolic_v71/**
!/reports/controlled_predictive_local_v72/**
!/reports/controlled_predictive_grouped_v73/**
!/reports/controlled_predictive_effect_v74/**
!/reports/controlled_predictive_parametric_v75/**
!/reports/controlled_predictive_decision_v76/**
!/reports/controlled_predictive_decision_v76.worker_checks/**
/reports/**/__pycache__/

# Small execution and verification evidence accompanies the published reports.
!/reports/**/configuration.json
!/reports/**/audit.json
!/reports/**/audit_costs.json
!/reports/**/execution.json
!/reports/**/audit_execution.json
!/reports/**/parent_*_receipt.json
!/reports/**/test_logs/*receipt.json
!/reports/**/run_process.py
!/reports/**/audit_process.py

# Native build products and test caches are regenerated by the source entrypoints.
/reports/**/runtime*/**
/reports/*runtime_tmp/**
/reports/**/test_logs/native*/**
/reports/**/pytest_cache/**
/reports/**/.pytest*/**
!/reports/publication/**

# Private planning notes and the locally archived literature/repository corpus.
# The curated third_party/ snapshot remains publishable project input.
/markdown/
/reference/

# Defense in depth only: V0-075 production laws, reveal salts, and signing
# private keys belong outside the repository. Never treat this ignored path as
# an authorization or persistence mechanism.
/.acfqp-private/

